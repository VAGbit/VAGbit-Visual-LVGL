<screen permanent="true">
    <view extends="lv_obj"
          width="320" height="170"
          style_bg_color="0x05070A" style_bg_opa="100%"
          style_border_width="0" style_pad_all="0" scrollable="false">

        <!-- Top accent line -->
        <lv_obj x="10" y="18" width="300" height="2"
                style_bg_color="0x1C5FA8" style_bg_opa="100%"
                style_border_width="0" style_radius="0"
                scrollable="false"/>

        <!-- Brand -->
        <lv_label text="VAGbit" x="12" y="6"
                  style_text_color="0xE8EDF2"/>
        <lv_label text="VISUAL" x="255" y="6"
                  style_text_color="0x00AEEF"/>

        <!-- LEFT MAIN GAUGE OUTER -->
        <lv_arc x="8" y="28" width="124" height="124"
                min_value="0" max_value="8000" value="3520"
                rotation="135" bg_start_angle="0" bg_end_angle="270"
                style_arc_color="0x9AA3AE" style_arc_width="3"
                style_arc_rounded="true"
                clickable="false"/>

        <!-- LEFT INNER RING -->
        <lv_arc x="25" y="45" width="90" height="90"
                min_value="0" max_value="8000" value="3520"
                rotation="135" bg_start_angle="0" bg_end_angle="270"
                style_arc_color="0x243447" style_arc_width="1"
                style_arc_rounded="true"
                clickable="false"/>

        <!-- LEFT BLUE ACCENT -->
        <lv_arc x="8" y="28" width="124" height="124"
                min_value="0" max_value="8000" value="4700"
                rotation="135" bg_start_angle="0" bg_end_angle="68"
                style_arc_color="0x00AEEF" style_arc_width="2"
                style_arc_rounded="true"
                clickable="false"/>

        <!-- LEFT CENTER DISC -->
        <lv_obj x="41" y="61" width="58" height="58"
                style_bg_color="0x0A0E13" style_bg_opa="100%"
                style_radius="29" style_border_width="1"
                style_border_color="0x202B36"
                style_pad_all="0" scrollable="false"/>

        <!-- LEFT TEXT -->
        <lv_label text="RPM" x="56" y="73"
                  style_text_color="0xA8B2BD"/>
        <lv_label text="3520" x="51" y="92"
                  style_text_color="0xF3F6F8"/>
        <lv_label text="1/min" x="55" y="108"
                  style_text_color="0x6F7B87"/>

        <!-- Fake needle (simple OEM-like slim line) -->
        <lv_obj x="69" y="61" width="2" height="44"
                style_bg_color="0xF5F7FA" style_bg_opa="100%"
                style_border_width="0" style_radius="1"
                scrollable="false"/>
        <lv_obj x="65" y="84" width="10" height="10"
                style_bg_color="0xF5F7FA" style_bg_opa="100%"
                style_radius="5" style_border_width="0"
                scrollable="false"/>

        <!-- RIGHT MAIN GAUGE OUTER -->
        <lv_arc x="188" y="28" width="124" height="124"
                min_value="-10" max_value="25" value="11"
                rotation="135" bg_start_angle="0" bg_end_angle="270"
                style_arc_color="0x9AA3AE" style_arc_width="3"
                style_arc_rounded="true"
                clickable="false"/>

        <!-- RIGHT INNER RING -->
        <lv_arc x="205" y="45" width="90" height="90"
                min_value="-10" max_value="25" value="11"
                rotation="135" bg_start_angle="0" bg_end_angle="270"
                style_arc_color="0x243447" style_arc_width="1"
                style_arc_rounded="true"
                clickable="false"/>

        <!-- RIGHT BLUE ACCENT -->
        <lv_arc x="188" y="28" width="124" height="124"
                min_value="-10" max_value="25" value="11"
                rotation="135" bg_start_angle="0" bg_end_angle="75"
                style_arc_color="0x00AEEF" style_arc_width="2"
                style_arc_rounded="true"
                clickable="false"/>

        <!-- RIGHT CENTER DISC -->
        <lv_obj x="221" y="61" width="58" height="58"
                style_bg_color="0x0A0E13" style_bg_opa="100%"
                style_radius="29" style_border_width="1"
